@model IEnumerable<DrinkStore.Models.Recipe>
@{ ViewData["Title"] = "Quản lý công thức"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý công thức pha chế</h2>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Recipes" asp-action="Create">+ Tạo công thức</a>
    </div>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    <form method="get" class="mb-3 d-flex gap-2">
        <input class="form-control" name="search" value="@ViewBag.Search" placeholder="Tìm tên đồ uống" />
        <button class="btn btn-outline-primary">Tìm</button>
    </form>
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>Đồ uống</th><th>Size</th><th>Số nguyên liệu</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var r in Model) {
            <tr><td>@r.MenuItem.Name</td><td>@r.Size</td><td>@r.RecipeItems.Count</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@r.RecipeId">Chi tiết</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.RecipeId">Sửa</a></td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center">Chưa có công thức.</td></tr> }
        </tbody>
    </table></div>
</div>
