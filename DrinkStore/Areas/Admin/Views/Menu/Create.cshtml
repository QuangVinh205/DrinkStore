@model DrinkStore.Models.MenuItem

@{
    ViewData["Title"] = "Thêm đồ uống";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between
        align-items-center mb-4">
        <h2>Thêm đồ uống mới</h2>

        <a asp-area="Admin"
           asp-controller="Menu"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Thông tin đồ uống
        </div>

        <div class="card-body">
            <form asp-area="Admin"
                  asp-controller="Menu"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label">
                        Tên đồ uống
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Ví dụ: Trà sữa trân châu" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Nhập mô tả đồ uống">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BasePrice"
                           class="form-label">
                        Giá bán (VNĐ)
                    </label>

                    <input asp-for="BasePrice"
                           type="number"
                           min="0"
                           step="1000"
                           class="form-control"
                           placeholder="35000" />

                    <span asp-validation-for="BasePrice"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl"
                           class="form-label">
                        Đường dẫn hình ảnh
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="/images/trasua.jpg" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Active"
                           class="form-check-input" />

                    <label asp-for="Active"
                           class="form-check-label">
                        Đang bán
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Lưu đồ uống
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Menu"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
