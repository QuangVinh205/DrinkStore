@model DrinkStore.Models.MenuItem

@{
    ViewData["Title"] = "Sửa đồ uống";
}

<h2>Sửa thông tin đồ uống</h2>

<form asp-area="Admin"
      asp-controller="Menu"
      asp-action="Edit"
      asp-route-id="@Model.ItemId"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <input type="hidden" asp-for="ItemId" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Tên đồ uống
        </label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">
            Mô tả
        </label>
        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="BasePrice" class="form-label">
            Giá bán
        </label>
        <input asp-for="BasePrice"
               type="number"
               min="0"
               step="1000"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label">
            Hình ảnh
        </label>
        <input asp-for="ImageUrl"
               class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="Active"
               class="form-check-input" />
        <label asp-for="Active"
               class="form-check-label">
            Đang bán
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Lưu thay đổi
    </button>

    <a asp-area="Admin"
       asp-controller="Menu"
       asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
