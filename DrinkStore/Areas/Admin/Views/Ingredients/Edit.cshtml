@model DrinkStore.Models.Ingredient
@{ ViewData["Title"] = "Sửa nguyên liệu"; }
<div class="container py-4"><h2>Sửa nguyên liệu</h2><form asp-action="Edit" asp-route-id="@Model.IngredientId" method="post" class="card card-body shadow-sm"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Tên nguyên liệu</label><input asp-for="Name" class="form-control" required maxlength="150" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Unit" class="form-label">Đơn vị</label><input asp-for="Unit" class="form-control" required maxlength="30" /><span asp-validation-for="Unit" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ReorderThreshold" class="form-label">Ngưỡng cảnh báo</label><input asp-for="ReorderThreshold" type="number" step="0.001" min="0" class="form-control" /><span asp-validation-for="ReorderThreshold" class="text-danger"></span></div>
<div><button class="btn btn-primary">Lưu thay đổi</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></form></div>
