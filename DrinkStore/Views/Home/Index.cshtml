@{ ViewData["Title"] = "Chọn vị ngon cho ngày của bạn"; }
<section class="fresh-intro page-width" aria-labelledby="fresh-title">
    <p class="fresh-pill">COFFEE, TEA & A GOOD DAY</p>
    <h1 id="fresh-title">Ngày đẹp hơn.<br /><span>Từ một ly ngon.</span></h1>
    <p>Cà phê đúng gu, trà thơm vừa vị. Một chút tươi mới cho ngày của bạn.</p>
