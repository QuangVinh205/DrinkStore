@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdmin = ViewContext.RouteData.Values["area"]?.ToString() == "Admin";
    var isHome = !isAdmin && controller == "Home" && action == "Index";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#234bd7" />
    <title>@ViewData["Title"] · DrinkStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/DrinkStore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fresh.css" asp-append-version="true" />
</head>
<body class="@(isAdmin ? "admin-page" : "store-page") @(isHome ? "home-page" : "inner-page")">
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-xl page-width" aria-label="Điều hướng chính">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-symbol" aria-hidden="true">d<span> /</span></span><span>drinkstore<small>COFFEE & TEA</small></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#store-navigation" aria-controls="store-navigation" aria-expanded="false" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="store-navigation">
                <div class="navbar-nav mx-auto">
                    <a class="nav-link @(isHome ? "active" : "")" aria-current="@(isHome ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <a class="nav-link @(!isAdmin && controller == "Menu" ? "active" : "")" aria-current="@(!isAdmin && controller == "Menu" ? "page" : null)" asp-area="" asp-controller="Menu" asp-action="Index">Thực đơn</a>
                    <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "" })#our-story">Câu chuyện</a>
                    @if (User.IsInRole("ShiftManager")) { <a class="nav-link @(isAdmin ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a> }
                </div>
                <div class="account-nav">
                    @if (User.Identity?.IsAuthenticated == true) {
                        <span class="account-name" title="@User.Identity.Name">Chào, @User.Identity.Name</span>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-primary btn-sm" type="submit">Đăng xuất</button></form>
                    } else {
                        <a class="login-link" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký <span aria-hidden="true">↗</span></a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" class="main-content @(isHome ? "" : "page-width")" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer">
        <div class="page-width footer-main">
            <div class="footer-identity"><a class="footer-wordmark" asp-area="" asp-controller="Home" asp-action="Index">drinkstore.</a><p>Cà phê đúng gu, trà thơm vừa vị.<br />Một chút tươi mới cho ngày của bạn.</p><a class="footer-menu-link" asp-area="" asp-controller="Menu" asp-action="Index">Khám phá thực đơn <span aria-hidden="true">↗</span></a></div>
            <nav class="footer-navigation" aria-label="Khám phá DrinkStore"><h2>Khám phá</h2><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a><a asp-area="" asp-controller="Menu" asp-action="Index">Thực đơn đồ uống</a><a href="@Url.Action("Index", "Home", new { area = "" })#our-story">Câu chuyện của chúng mình</a></nav>
            <nav class="footer-navigation" aria-label="Tài khoản và thông tin"><h2>Tài khoản & thông tin</h2><a asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a><a asp-area="" asp-controller="Account" asp-action="Register">Tạo tài khoản</a><a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách riêng tư</a></nav>
        </div>
        <div class="page-width footer-bottom"><span>© @DateTime.Now.Year DrinkStore</span><span>Một ly ngon. Một ngày vui.</span></div>
    </footer>
    <button class="back-to-top" type="button" aria-label="Lên đầu trang" title="Lên đầu trang" hidden><span aria-hidden="true">↑</span></button>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
