@model DrinkStore.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-shell">
    <div class="auth-intro"><p class="eyebrow">CHÀO MỪNG TRỞ LẠI</p><h1>Một ly quen.<br />Một ngày vui.</h1><img src="~/images/caphesua.jpg" alt="" width="350" height="200" /><p>Đăng nhập và tiếp tục khám phá hương vị bạn yêu thích tại DrinkStore.</p></div>
    <div class="auth-form"><h2>Đăng nhập</h2><p>Rất vui được gặp lại bạn.</p>
        <form asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="username" placeholder="ban@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label></div>
            <button type="submit" class="btn btn-primary w-100">Đăng nhập →</button>
        </form>
        <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Đăng ký ngay</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
