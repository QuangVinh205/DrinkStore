@model DrinkStore.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<section class="auth-shell">
    <div class="auth-intro"><p class="eyebrow">HELLO, BẠN MỚI!</p><h1>Thêm hương vị.<br />Thêm niềm vui.</h1><img src="~/images/caphesua.jpg" alt="" width="350" height="200" /><p>Bắt đầu hành trình khám phá những ly đồ uống yêu thích cùng DrinkStore.</p></div>
    <div class="auth-form"><h2>Tạo tài khoản</h2><p>Chỉ vài thông tin để chúng mình làm quen.</p>
        <form asp-area="" asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="FullName" class="form-label">Họ và tên</label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Tên của bạn" /><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="username" placeholder="ban@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-hint" /><div id="password-hint" class="form-text">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường và số.</div><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Tạo tài khoản →</button>
        </form>
        <p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
